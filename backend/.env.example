# Copy to ".env" in this folder (backend/)
#   cp .env.example .env
# Run the API from the backend directory: python main.py
# load_dotenv() runs from modules that need keys (cwd should be backend/).

# TomTom — used by fetch_data/TomTomTraffic.py
TOMTOM_API_KEY=

# Used by fetch_data/MapHazardAPIs.py (names match historical NEXT_PUBLIC_* usage)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_TOMTOM_API_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Tip: You can set the same TomTom key for both TOMTOM_API_KEY and NEXT_PUBLIC_TOMTOM_API_KEY
# if you use TomTom in both traffic and map hazard helpers.
