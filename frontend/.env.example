# Copy to ".env.local" (recommended for Next.js) or ".env"
#   cp .env.example .env.local
# Then fill in real values. Never commit .env* files.

# Mapbox GL (required for the map)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Simulation Studio FastAPI backend (exposure assessment, some map APIs)
# Default in code is http://localhost:8000 if unset
NEXT_PUBLIC_BACKEND_ENDPOINT=http://localhost:8000

# TomTom (traffic / routing features — optional; features log errors if missing)
NEXT_PUBLIC_TOMTOM_API_KEY=

# Atlas / SafeGIS AI (LangGraph or compatible endpoint)
# Example shape from code: http://localhost:8002/generate
NEXT_PUBLIC_MODEL_ENDPOINT=
